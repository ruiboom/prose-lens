{
  "name": "prose-lens",
  "version": "0.1.0",
  "private": true,
  "description": "See many aspects of a piece of writing at once: syntax, diction, prosody, argument and references, lined up as lanes against the text.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "jsdom": "^30.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "cmu-pronouncing-dictionary": "^3.0.0",
    "syllable": "^5.0.1"
  }
}
